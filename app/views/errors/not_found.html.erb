<div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-20 h-20 bg-rose-500/10 text-rose-500 rounded-3xl flex items-center justify-center mb-6 border border-rose-500/20 shadow-xl shadow-rose-500/5">
    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
  </div>
  <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Visiting Card Not Found</h1>
  <p class="text-slate-600 dark:text-slate-400 max-w-md mb-8">The digital visiting card link you are trying to visit does not exist or may have been updated.</p>
  <div class="flex items-center gap-4">
    <%= link_to root_path, class: "px-6 py-3 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-500 transition shadow-lg shadow-indigo-500/20" do %>
      Go to Homepage
    <% end %>
    <%= link_to new_user_registration_path, class: "px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition" do %>
      Create Your Own Card
    <% end %>
  </div>
</div>

