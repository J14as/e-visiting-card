<% content_for :title, "Dashboard | CardForge" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8" data-controller="clipboard">
  <!-- Top Stats & Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Your Digital Visiting Cards</h1>
      <p class="text-sm text-slate-400 mt-1">Manage, customize, and share your dynamic visiting cards and QR codes.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to new_card_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/25 transition active:scale-95" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Create New Card</span>
      <% end %>
    </div>
  </div>

  <!-- Summary Metrics Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Cards</p>
        <p class="text-2xl sm:text-3xl font-extrabold text-white mt-1"><%= @active_cards_count %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center border border-indigo-500/20">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Profile Views</p>
        <p class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-1"><%= @total_views %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/20">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">QR Code Status</p>
        <p class="text-base font-bold text-white mt-1">Live & Active</p>
        <p class="text-xs text-slate-400 mt-0.5">Dynamic Smart QR</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center border border-cyan-500/20">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Cards Collection -->
  <% if @cards.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @cards.each do |card| %>
        <% public_url = card_public_url(card) %>
        <div class="group relative rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition shadow-xl overflow-hidden flex flex-col justify-between">
          <!-- Card Header Banner -->
          <div class="p-5 pb-4 border-b border-slate-800/80">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                  <%= card.card_title %>
                </span>
                <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition truncate max-w-[200px]" title="<%= card.full_name %>">
                  <%= card.full_name %>
                </h3>
                <p class="text-xs text-slate-400 truncate max-w-[200px]">
                  <%= card.designation.presence || "No designation set" %>
                </p>
              </div>

              <!-- Quick QR Thumbnail -->
              <div class="w-16 h-16 bg-white p-1 rounded-xl shadow-md shrink-0 flex items-center justify-center">
                <%= raw card.qr_code_svg(public_url, module_size: 2) %>
              </div>
            </div>

            <!-- Tags: Style & Theme -->
            <div class="flex items-center gap-2 mt-4 text-[11px] flex-wrap">
              <span class="px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 font-medium border border-slate-700/60">
                <%= card.template_config[:name] %>
              </span>
              <span class="px-2 py-0.5 rounded text-white font-medium flex items-center gap-1.5 <%= card.color_config[:badge] %> bg-opacity-20 border border-current text-[10px]">
                <span class="w-1.5 h-1.5 rounded-full <%= card.color_config[:badge] %>"></span>
                <%= card.color_config[:name] %>
              </span>
              <% if card.has_resume? %>
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/15 text-rose-300 border border-rose-500/30 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                  Resume Attached
                </span>
              <% else %>
                <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-800/60 text-slate-400 border border-slate-700/40">
                  No Resume
                </span>
              <% end %>
              <span class="ml-auto text-slate-400 flex items-center gap-1 text-[11px]">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <%= card.views_count %> views
              </span>
            </div>
          </div>

          <!-- Public Link Display & Quick Copy -->
          <div class="px-5 py-3 bg-slate-950/40 border-b border-slate-800/80 flex items-center justify-between text-xs">
            <div class="flex items-center gap-1.5 text-slate-400 truncate max-w-[220px]">
              <span class="text-slate-500 font-mono">/c/</span>
              <span class="font-mono text-indigo-300 truncate"><%= card.slug %></span>
            </div>

            <div class="flex items-center gap-2">
              <button type="button" 
                      data-action="click->clipboard#copy" 
                      data-clipboard-text-param="<%= public_url %>" 
                      class="text-xs text-indigo-400 hover:text-indigo-300 font-medium inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Copy Link
              </button>

              <%= link_to public_url, target: "_blank", class: "text-slate-400 hover:text-white", title: "Open public profile" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              <% end %>
            </div>
          </div>

          <!-- Actions Bar -->
          <div class="p-4 bg-slate-950/20 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <%= link_to edit_card_path(card), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-sm" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Edit
              <% end %>

              <%= link_to download_pdf_card_path(card), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition", title: "Download 3.5\"x2\" Card PDF" do %>
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                PDF
              <% end %>

              <%= link_to download_pdf_card_path(card, layout: :sheet), class: "p-1.5 rounded-lg text-slate-400 hover:text-emerald-400 hover:bg-emerald-500/10 transition", title: "Download A4 Print Sheet" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
              <% end %>

              <% if card.has_resume? %>
                <%= link_to download_resume_card_path(card), target: "_blank", class: "p-1.5 rounded-lg text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition", title: "Download Attached Resume" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                <% end %>
              <% end %>

              <a href="https://wa.me/?text=<%= CGI.escape("Connect with #{card.full_name}: #{public_url}") %>" target="_blank" class="p-1.5 rounded-lg text-slate-400 hover:text-emerald-400 hover:bg-emerald-500/10 transition" title="Share via WhatsApp">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                </svg>
              </a>
            </div>

            <!-- Card Submenu / Duplicate / Delete -->
            <div class="flex items-center gap-1">
              <%= button_to duplicate_card_path(card), method: :post, class: "p-1.5 rounded-lg text-slate-400 hover:text-indigo-400 hover:bg-indigo-500/10 transition", title: "Duplicate Card" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                </svg>
              <% end %>

              <%= button_to card_path(card), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this card?" }, class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition", title: "Delete Card" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="p-12 text-center rounded-3xl bg-slate-900/40 border border-dashed border-slate-800 max-w-xl mx-auto space-y-5">
      <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mx-auto border border-indigo-500/20">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
        </svg>
      </div>
      <div class="space-y-1">
        <h3 class="text-xl font-bold text-white">No digital visiting cards yet</h3>
        <p class="text-sm text-slate-400">Create your first card to generate your custom public link, dynamic QR code, and print-ready PDF.</p>
      </div>
      <div class="pt-2">
        <%= link_to new_card_path, class: "inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition active:scale-95" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Create Your First Card</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
