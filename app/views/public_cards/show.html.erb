<% content_for :title, "#{@card.full_name} | Digital Card" %>

<div class="w-full max-w-md mx-auto px-4 py-8 sm:py-12 space-y-6" data-controller="clipboard modal" data-theme-style="<%= @card.template_style %>" data-theme-color="<%= @card.color_theme %>">
  <!-- Top Utility Bar (Share & QR Trigger) -->
  <div class="flex items-center justify-between">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-black/20 border border-white/10 opacity-80">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Verified Card</span>
    </div>

    <div class="flex items-center gap-2">
      <!-- Show QR Code Modal Button -->
      <button type="button" 
              data-action="click->modal#open"
              class="p-2.5 rounded-full backdrop-blur-md bg-white/10 hover:bg-white/20 border border-white/15 transition shadow-sm"
              title="Show QR Code">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
        </svg>
      </button>

      <!-- Copy Profile Link Button -->
      <button type="button" 
              data-action="click->clipboard#copy" 
              data-clipboard-text-param="<%= @public_url %>"
              class="p-2.5 rounded-full backdrop-blur-md bg-white/10 hover:bg-white/20 border border-white/15 transition shadow-sm"
              title="Copy Profile Link">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Main Card Container -->
  <div class="public-profile-card relative rounded-3xl p-6 sm:p-8 <%= @card.template_config[:card_bg] %> text-center space-y-6">
    <!-- Avatar / Initials Ring -->
    <div class="flex justify-center">
      <div class="relative">
        <div class="public-card-initials w-24 h-24 rounded-3xl <%= @card.color_config[:badge] %> text-white font-extrabold flex items-center justify-center text-3xl shadow-2xl border-4 border-white/20">
          <%= @card.initials %>
        </div>
        <div class="absolute -bottom-1.5 -right-1.5 w-7 h-7 rounded-full bg-slate-950 border-2 border-white/40 flex items-center justify-center">
          <span class="w-3.5 h-3.5 rounded-full <%= @card.color_config[:badge] %>"></span>
        </div>
      </div>
    </div>

    <!-- Identity & Role -->
    <div class="space-y-1.5">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        <%= @card.full_name %>
      </h1>
      <% if @card.designation.present? %>
        <p class="text-sm font-semibold <%= @card.template_config[:accent] %>">
          <%= @card.designation %>
        </p>
      <% end %>
      <% if @card.company_or_tagline.present? %>
        <p class="text-xs opacity-75 font-medium">
          <%= @card.company_or_tagline %>
        </p>
      <% end %>
    </div>

    <!-- Brief Bio -->
    <% if @card.bio.present? %>
      <div class="p-4 rounded-2xl bg-black/15 border border-current/10 text-xs leading-relaxed text-left opacity-90">
        <%= simple_format(@card.bio, class: "mb-0") %>
      </div>
    <% end %>

    <!-- PRIMARY ACTIONS: SAVE CONTACT & DOWNLOAD RESUME -->
    <div class="space-y-2.5">
      <%= link_to public_card_vcard_path(@card.slug), class: "w-full py-3.5 px-6 rounded-2xl font-bold text-sm text-white #{ @card.color_config[:badge] } shadow-xl shadow-current/20 flex items-center justify-center gap-2.5 transition active:scale-[0.98] hover:opacity-95" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <span>Save Contact to Phone</span>
      <% end %>

      <% if @card.has_resume? %>
        <%= link_to public_card_resume_path(@card.slug), target: "_blank", class: "w-full py-3.5 px-6 rounded-2xl font-bold text-sm bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 hover:from-rose-500 hover:to-amber-400 text-white shadow-xl shadow-rose-500/25 flex items-center justify-center gap-2.5 transition active:scale-[0.98]" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume / CV</span>
        <% end %>
      <% else %>
        <div class="w-full py-3 px-5 rounded-2xl text-xs font-medium bg-white/5 border border-dashed border-white/15 text-slate-400 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Resume / CV</span>
          </div>
          <span class="text-[11px] px-2 py-0.5 rounded-full bg-white/10 text-slate-400">Available upon request</span>
        </div>
      <% end %>

      <p class="text-[11px] opacity-60">Instant contact import & verified portfolio download</p>
    </div>

    <!-- DIRECT QUICK ACTIONS GRID -->
    <div class="grid grid-cols-2 gap-3 pt-2">
      <% if @card.has_resume? %>
        <%= link_to public_card_resume_path(@card.slug), target: "_blank", class: "py-3 px-4 rounded-2xl bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/30 text-rose-300 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95 col-span-2 sm:col-span-1" do %>
          <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Resume (PDF)</span>
        <% end %>
      <% end %>
      <!-- WhatsApp Direct Chat -->
      <% if @card.phone.present? %>
        <a href="<%= @card.whatsapp_url %>" target="_blank" class="py-3 px-4 rounded-2xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-emerald-300 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <a href="tel:<%= @card.phone.gsub(/[^0-9+]/, '') %>" class="py-3 px-4 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Phone</span>
        </a>
      <% end %>

      <% if @card.email.present? %>
        <a href="mailto:<%= @card.email %>" class="py-3 px-4 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Send Email</span>
        </a>
      <% end %>

      <% if (@card.portfolio_url.presence || @card.website_url.presence).present? %>
        <% target_web = @card.portfolio_url.presence || @card.website_url %>
        <a href="<%= target_web %>" target="_blank" rel="noopener" class="py-3 px-4 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span>Website</span>
        </a>
      <% end %>
    </div>

    <!-- SOCIAL LINKS LIST -->
    <div class="space-y-2.5 pt-2">
      <% if @card.linkedin_url.present? %>
        <a href="<%= @card.linkedin_url %>" target="_blank" rel="noopener" class="w-full py-3 px-4 rounded-2xl bg-black/20 hover:bg-black/30 border border-white/10 text-xs font-semibold flex items-center justify-between transition">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </span>
            <span>Connect on LinkedIn</span>
          </div>
          <svg class="w-4 h-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      <% end %>

      <% if @card.github_url.present? %>
        <a href="<%= @card.github_url %>" target="_blank" rel="noopener" class="w-full py-3 px-4 rounded-2xl bg-black/20 hover:bg-black/30 border border-white/10 text-xs font-semibold flex items-center justify-between transition">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-xl bg-white/10 text-white flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </span>
            <span>Follow on GitHub</span>
          </div>
          <svg class="w-4 h-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      <% end %>

      <% if @card.instagram_url.present? %>
        <a href="<%= @card.instagram_url %>" target="_blank" rel="noopener" class="w-full py-3 px-4 rounded-2xl bg-black/20 hover:bg-black/30 border border-white/10 text-xs font-semibold flex items-center justify-between transition">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </span>
            <span>Instagram Profile</span>
          </div>
          <svg class="w-4 h-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      <% end %>
    </div>

    <!-- EXPORT OPTIONS: PDF & SHARE -->
    <div class="pt-4 border-t border-current/10 space-y-3">
      <div class="grid grid-cols-2 gap-2 text-xs">
        <%= link_to public_card_pdf_path(@card.slug), class: "py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 font-semibold flex items-center justify-center gap-1.5 transition", title: "Standard 3.5\"x2\" double-sided card PDF" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Card PDF</span>
        <% end %>

        <%= link_to public_card_pdf_path(@card.slug, layout: :sheet), class: "py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 font-semibold flex items-center justify-center gap-1.5 transition", title: "Printable A4 sheet with front & back side-by-side" do %>
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print Sheet</span>
        <% end %>
      </div>

      <a href="https://wa.me/?text=<%= CGI.escape("Connect with #{@card.full_name}: #{@public_url}") %>" target="_blank" class="w-full py-2.5 px-3 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-emerald-300 font-semibold text-xs flex items-center justify-center gap-1.5 transition">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Share via WhatsApp</span>
      </a>

      <!-- Quick Copy Link button -->
      <button type="button" 
              data-action="click->clipboard#copy" 
              data-clipboard-target="button"
              data-clipboard-text-param="<%= @public_url %>" 
              class="w-full py-2.5 px-3 rounded-xl bg-black/20 hover:bg-black/30 border border-white/10 text-xs font-medium flex items-center justify-center gap-1.5 transition">
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Copy Card Link</span>
      </button>
    </div>
  </div>

  <!-- QR Code Modal (Triggered by QR button) -->
  <div data-modal-target="modal" 
       data-action="click->modal#closeOnBackdrop keydown.esc@window->modal#closeOnEscape"
       class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div data-modal-target="dialog" class="w-full max-w-sm rounded-3xl bg-slate-900 border border-slate-700 p-6 text-center text-white space-y-4 shadow-2xl">
      <div class="flex items-center justify-between pb-2 border-b border-slate-800">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">Scan QR Code</span>
        <button type="button" data-action="click->modal#close" class="p-1 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- QR Display -->
      <div class="p-4 bg-white rounded-2xl inline-block shadow-inner">
        <%= raw @qr_svg %>
      </div>

      <div class="space-y-1">
        <p class="font-bold text-base"><%= @card.full_name %></p>
        <p class="text-xs text-slate-400 font-mono">/c/<%= @card.slug %></p>
        <p class="text-[11px] text-slate-500">Scan with any smartphone camera to open this digital card.</p>
      </div>

      <div class="pt-2">
        <button type="button" data-action="click->modal#close" class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
