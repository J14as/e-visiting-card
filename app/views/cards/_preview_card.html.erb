<!-- Card Preview Component (Hotwire Stimulus Controlled) -->
<div class="space-y-4" 
     id="live-preview-box"
     data-card-preview-target="previewCardContainer"
     data-theme-style="<%= card.template_style %>"
     data-theme-color="<%= card.color_theme %>">

  <!-- Preview Toolbar & Side Flip Toggle -->
  <div class="flex items-center justify-between gap-3 bg-slate-900/60 p-3 rounded-2xl border border-slate-800">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-xs font-semibold text-slate-300">Live Preview</span>
    </div>

    <button type="button" 
            data-action="click->card-preview#toggleSide" 
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
      <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span data-card-preview-target="flipBtnLabel">View Back Side (QR)</span>
    </button>
  </div>

  <!-- Physical Card Representation (Aspect Ratio 3.5:2 ~ 1.75:1) -->
  <div class="w-full relative rounded-3xl p-6 sm:p-7 shadow-2xl transition-all duration-300 card-theme-bg border"
       style="min-height: 280px;">

    <!-- FRONT SIDE -->
    <div data-card-preview-target="previewCardFront" class="space-y-4 flex flex-col justify-between h-full">
      <!-- Card Top: Tagline / Brand Badge & Initials -->
      <div class="flex items-start justify-between gap-3">
        <div class="space-y-1 min-w-0 flex-1">
          <p class="text-[11px] font-bold uppercase tracking-wider accent-color" data-card-preview-target="previewCompany">
            <%= card.company_or_tagline.presence || "Nexus Systems & SaaS Labs" %>
          </p>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight" data-card-preview-target="previewFullName">
            <%= card.full_name.presence || "Alex Sterling" %>
          </h2>
          <p class="text-xs sm:text-sm font-medium opacity-80" data-card-preview-target="previewDesignation">
            <%= card.designation.presence || "Principal Cloud Architect" %>
          </p>
        </div>

        <!-- Initials Avatar -->
        <div class="w-12 h-12 rounded-2xl accent-bg text-white font-extrabold flex items-center justify-center text-lg shadow-lg shrink-0" data-card-preview-target="previewInitials">
          <%= card.initials %>
        </div>
      </div>

      <!-- Card Middle: Brief Bio -->
      <div class="py-2">
        <p class="text-xs opacity-75 leading-relaxed line-clamp-3" data-card-preview-target="previewBio">
          <%= card.bio.presence || "Building high-performance distributed systems, scalable web apps, and modern developer infrastructure." %>
        </p>
      </div>

      <!-- Card Bottom: Contact Info & Socials -->
      <div class="pt-3 border-t border-current/10 space-y-2 text-xs">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 opacity-90">
          <div data-card-preview-target="previewPhoneContainer" class="flex items-center gap-1.5 <%= card.phone.blank? ? 'hidden' : '' %>">
            <svg class="w-3.5 h-3.5 accent-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span data-card-preview-target="previewPhone"><%= card.phone %></span>
          </div>

          <div data-card-preview-target="previewEmailContainer" class="flex items-center gap-1.5 <%= card.email.blank? ? 'hidden' : '' %>">
            <svg class="w-3.5 h-3.5 accent-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span data-card-preview-target="previewEmail"><%= card.email %></span>
          </div>

          <div data-card-preview-target="previewWebsiteContainer" class="flex items-center gap-1.5 <%= (card.portfolio_url.presence || card.website_url.presence).blank? ? 'hidden' : '' %>">
            <svg class="w-3.5 h-3.5 accent-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span data-card-preview-target="previewWebsite"><%= (card.portfolio_url.presence || card.website_url.presence).to_s.sub(%r{\Ahttps?://(www\.)?}, '') %></span>
          </div>
        </div>

        <!-- Social Badges Preview Row -->
        <div class="flex items-center gap-2 pt-1">
          <span data-card-preview-target="previewLinkedin" class="p-1 rounded bg-current/10 transition <%= card.linkedin_url.blank? ? 'opacity-25 grayscale pointer-events-none' : 'opacity-100' %>" title="LinkedIn">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </span>
          <span data-card-preview-target="previewGithub" class="p-1 rounded bg-current/10 transition <%= card.github_url.blank? ? 'opacity-25 grayscale pointer-events-none' : 'opacity-100' %>" title="GitHub">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </span>
          <span data-card-preview-target="previewInstagram" class="p-1 rounded bg-current/10 transition <%= card.instagram_url.blank? ? 'opacity-25 grayscale pointer-events-none' : 'opacity-100' %>" title="Instagram">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </span>
          <span data-card-preview-target="previewPortfolio" class="p-1 rounded bg-current/10 transition <%= card.portfolio_url.blank? ? 'opacity-25 grayscale pointer-events-none' : 'opacity-100' %>" title="Portfolio">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- BACK SIDE (Dynamic QR Code Layout) -->
    <div data-card-preview-target="previewCardBack" class="hidden space-y-4 flex flex-col items-center justify-center text-center h-full py-2">
      <div class="p-3 bg-white rounded-2xl shadow-xl inline-block border border-slate-200">
        <%= raw card.qr_code_svg(public_url, module_size: 4) %>
      </div>

      <div class="space-y-1">
        <p class="text-xs font-bold uppercase tracking-widest accent-color">Scan To Connect</p>
        <p class="text-xs opacity-75 font-mono">/c/<span data-card-preview-target="previewSlug"><%= card.slug %></span></p>
        <p class="text-[11px] opacity-60">Opens mobile profile & enables 1-tap contact save.</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions Panel Below Preview -->
  <% if card.persisted? %>
    <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Public Profile Link</span>
        <button type="button" 
                data-action="click->clipboard#copy" 
                data-clipboard-text-param="<%= public_url %>" 
                class="text-indigo-400 hover:text-indigo-300 font-semibold inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy URL
        </button>
      </div>

      <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 text-xs font-mono text-indigo-300 truncate">
        <%= public_url %>
      </div>

      <!-- Mobile Testing / Ngrok Host Assistant -->
      <% if active_app_host.include?("localhost") || active_app_host.include?("127.0.0.1") %>
        <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-[11px] text-amber-300 space-y-1.5">
          <div class="flex items-center gap-1.5 font-semibold">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Scanning with phone camera?</span>
          </div>
          <p class="text-[10.5px] text-amber-300/80 leading-tight">
            Run <code class="text-white bg-slate-900 px-1 py-0.5 rounded font-mono">ngrok http 3000</code> and paste your ngrok URL below to update the QR code:
          </p>
          <%= form_with url: request.path, method: :get, class: "flex items-center gap-1.5 pt-0.5" do %>
            <input type="url" name="app_host" placeholder="https://xxxx.ngrok-free.app" required class="flex-grow px-2 py-1 rounded bg-slate-950 border border-slate-700 text-[11px] text-white placeholder-slate-500 focus:outline-none focus:border-amber-400">
            <button type="submit" class="px-2.5 py-1 rounded bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-[11px] transition shrink-0 cursor-pointer">Set</button>
          <% end %>
        </div>
      <% else %>
        <div class="flex items-center justify-between p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-[11px] text-emerald-300">
          <div class="flex items-center gap-1.5 truncate">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            <span class="truncate">Mobile Scannable: <strong class="text-white"><%= active_app_host %></strong></span>
          </div>
          <%= link_to "Reset", request.path + "?clear_app_host=1", class: "text-[10px] text-emerald-400 hover:text-white underline ml-2 shrink-0" %>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-2 pt-1">
        <%= link_to download_pdf_card_path(card), class: "inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md transition", title: "Standard 3.5\"x2\" PDF" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Card PDF</span>
        <% end %>

        <%= link_to download_pdf_card_path(card, layout: :sheet), class: "inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition", title: "A4 Printable Sheet with Front & Back" do %>
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>A4 Sheet</span>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-2 pt-0.5">
        <%= link_to download_qr_card_path(card, fmt: :png), class: "inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-medium bg-slate-950/60 hover:bg-slate-800 text-slate-300 border border-slate-800 transition" do %>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>QR (PNG)</span>
        <% end %>

        <%= link_to download_qr_card_path(card, fmt: :svg), class: "inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-medium bg-slate-950/60 hover:bg-slate-800 text-indigo-400 border border-slate-800 transition" do %>
          <span>QR (SVG Vector)</span>
        <% end %>
      </div>

      <% if card.has_resume? %>
        <div class="pt-1">
          <%= link_to download_resume_card_path(card), target: "_blank", class: "w-full py-2 px-3 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/25 text-rose-300 text-xs font-semibold flex items-center justify-center gap-2 transition" do %>
            <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Preview Attached Resume</span>
          <% end %>
        </div>
      <% end %>

      <div class="flex items-center justify-between pt-1">
        <%= link_to public_url, target: "_blank", class: "text-xs text-slate-400 hover:text-white inline-flex items-center gap-1.5" do %>
          <span>Open public mobile view</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        <% end %>

        <%= link_to download_qr_card_path(card, fmt: :svg), class: "text-xs text-indigo-400 hover:text-indigo-300 font-medium" do %>
          Get QR Vector (SVG)
        <% end %>
      </div>
    </div>
  <% end %>
</div>
