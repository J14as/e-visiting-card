<% content_for :title, "Edit #{@card.full_name} | CardForge" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" data-controller="card-preview clipboard">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <%= link_to "Dashboard", dashboard_path, class: "hover:text-white transition" %>
        <span>/</span>
        <span class="text-indigo-400">Card Builder</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight"><%= @card.card_title %></h1>
      <p class="text-sm text-slate-400 mt-1">
        Public Slug: <code class="text-indigo-400 font-mono">/c/<%= @card.slug %></code> &bull; <%= @card.views_count %> profile views
      </p>
    </div>

    <!-- Quick Export Bar -->
    <div class="flex flex-wrap items-center gap-2.5">
      <%= link_to public_card_path(@card.slug), target: "_blank", class: "inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition" do %>
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        <span>Public Profile</span>
      <% end %>

      <%= link_to download_pdf_card_path(@card), class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/25 transition active:scale-95", title: "Standard 3.5\" x 2.0\" double-sided business card PDF" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Card PDF (3.5\"×2\")</span>
      <% end %>

      <%= link_to download_pdf_card_path(@card, layout: :sheet), class: "inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition", title: "A4 printable sheet with front & back side-by-side with crop marks" do %>
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>A4 Print Sheet</span>
      <% end %>
    </div>
  </div>

  <!-- Split Screen Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <!-- Left Column: Edit Form -->
    <div class="lg:col-span-7">
      <%= render "form", card: @card %>
    </div>

    <!-- Right Column: Sticky Live Preview -->
    <div class="lg:col-span-5 lg:sticky lg:top-24">
      <%= render "preview_card", card: @card, public_url: @public_url %>
    </div>
  </div>
</div>
